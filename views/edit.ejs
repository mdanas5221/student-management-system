<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Student</title>
  <link rel="stylesheet" href="/edit.css">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
</head>

<body>
  <div class="form-card">
    <div class="form-heading">
      <h1>Edit Student</h1>

      <p>Update student information below.</p>
    </div>

    <form method="post" action="/student/<%= student.id %>?_method=PATCH">
      <div class="form-grid">
        <div class="input-box">
          <label>Full Name</label>
          <input type="text" value="<%= student.name %>" name="name"/>
        </div>

        <div class="input-box">
          <label>Age</label>
          <input type="number" value="<%= student.age %>" name="age"/>
        </div>

        <div class="input-box select-box">
          <label>Gender</label>
          <select name="gender">
            <option value="Male" <%= student.gender === "Male" ? "selected" : "" %>>Male</option>
            <option value="Female" <%= student.gender === "Female" ? "selected" : "" %>>Female</option>
            <option value="Other" <%= student.gender === "Other" ? "selected" : "" %>>Other</option>
          </select>
          <i class="fa-solid fa-chevron-down"></i>
        </div>

        <div class="input-box">
          <label>Course</label>
          <input type="text" value="<%= student.course %>" name="course"/>
        </div>

        <div class="input-box">
          <label>Roll Number</label>
          <input type="text" value="<%= student.roll_no %>" name="roll_no"/>
        </div>

        <div class="input-box">
          <label>Email</label>
          <input type="email" value="<%= student.email %>" name="email"/>
        </div>

        <div class="input-box">
          <label>Phone Number</label>
          <input type="tel" value="<%= student.phone %>" name="phone"/>
        </div>

        <div class="input-box">
          <label>City</label>
          <input type="text" value="<%= student.city %>" name="city"/>
        </div>

        <div class="input-box select-box">
          <label>Status</label>
          <select name="status">
            <option value="Active" <%= student.status === "Active" ? "selected" : "" %>>Active</option>
            <option value="Inactive" <%= student.status === "Inactive" ? "selected" : "" %>>Inactive</option>
          </select>
          <i class="fa-solid fa-chevron-down"></i>
        </div>

        <div class="input-box">
          <label>Address</label>
          <input type="text" value="<%= student.address %>" name="address">
        </div>
      </div>



      <div class="form-buttons">
        <a href="http://localhost:3000/student" class="back-btn">Cancel</a>
        <button class="save-btn">Save Changes</button>
      </div>
    </form>
  </div>
</body>

</html>